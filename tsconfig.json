{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "paths": {
      "@page/*": ["./src/page/*"],
      "@fixtures/*": ["./src/fixtures/*"],
      "@utilities/*": ["./src/utilities/*"],
      "@data/*": ["./src/data/*"],
      "@tier1-data/*": ["./src/data/tier1-functional/*"],
      "@tier2-data/*": ["./src/data/tier2-visual/*"],
      "@tier3-data/*": ["./src/data/tier3-api/*"],
      "@specs/*": ["./src/specs/*"],
      "@interfaces": ["./src/interfaces/index.ts"],
      "@interfaces/*": ["./src/interfaces/*"],
      "@api": ["./src/api/index.ts"],
      "@api/*": ["./src/api/*"]
    }
  },
  "include": [
    "src/**/*",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
